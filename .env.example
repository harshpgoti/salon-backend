# Local synthetic development only. Never use these values outside a developer machine.
POSTGRES_DB=salon
POSTGRES_USER=salon
POSTGRES_PASSWORD=local-dev-only
DATABASE_URL=postgresql+psycopg://salon_app:local-dev-only@127.0.0.1:5433/salon
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000

# OIDC settings are intentionally unset. Use separate Cognito pools/clients per surface.
STAFF_OIDC_ISSUER=
STAFF_OIDC_CLIENT_ID=
STAFF_OIDC_AUTHORIZATION_ENDPOINT=
STAFF_OIDC_TOKEN_ENDPOINT=
STAFF_OIDC_JWKS_URL=
COMPANY_OIDC_ISSUER=
COMPANY_OIDC_CLIENT_ID=
COMPANY_OIDC_AUTHORIZATION_ENDPOINT=
COMPANY_OIDC_TOKEN_ENDPOINT=
COMPANY_OIDC_JWKS_URL=
AUTH_STATE_SECRET=
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_DOMAIN=
